{% trans_default_domain 'global' %}

<dialog id="toolbox" class="modal modal-bottom sm:modal-middle">
	<div class="modal-box w-full max-w-2xl overflow-hidden p-0 shadow-2xl">
		<header class="border-base-content/10 bg-base-200/60 flex items-center justify-between gap-6 border-b px-6 py-5 sm:px-8">
			<div>
				<h3 class="text-xl font-black tracking-tight">Toolbox</h3>
			</div>
			<form method="dialog">
				<button class="btn btn-circle btn-ghost btn-sm" aria-label="Close toolbox">
					<i class="fa-solid fa-xmark"></i>
				</button>
			</form>
		</header>

		<div class="py-4 sm:px-7 sm:py-5">
			{% set themes = ['light', 'dark', 'cupcake', 'bumblebee', 'emerald', 'corporate', 'synthwave', 'retro', 'cyberpunk', 'valentine', 'halloween', 'garden', 'forest', 'aqua', 'lofi', 'pastel', 'fantasy', 'wireframe', 'black', 'luxury', 'dracula', 'cmyk', 'autumn', 'business', 'acid', 'lemonade', 'night', 'coffee', 'winter', 'dim', 'nord', 'sunset', 'caramellatte', 'abyss', 'silk'] %}
			<section class="sm:border-base-content/15 rounded-xl sm:border p-4" aria-labelledby="theme-section-title" data-theme-list="{{ themes|join(',') }}">
				<div class="mb-3 flex items-center gap-2">
					<i class="fa-solid fa-palette text-primary text-sm"></i>
					<h4 id="theme-section-title" class="text-sm font-black uppercase tracking-wider">Theme</h4>
				</div>
				<div class="bg-base-200 mt-2 flex items-center justify-between gap-3 rounded-lg px-3 py-2">
					<button type="button" class="btn btn-circle btn-lg sm:btn-sm" data-theme-step="-1" aria-label="Previous theme">
						<i class="fa-solid fa-chevron-left"></i>
					</button>
					<div class="min-w-0 text-center">
						<p class="text-base-content/50 text-[10px] font-bold uppercase tracking-widest">{% trans %}Selected theme{% endtrans %}</p>
						<p class="truncate text-lg font-black" data-theme-name>corporate</p>
					</div>
					<div class="flex shrink-0 gap-1" aria-label="Theme colors">
						<span class="bg-primary h-5 w-5 rounded-full"></span>
						<span class="bg-secondary h-5 w-5 rounded-full"></span>
						<span class="bg-accent h-5 w-5 rounded-full"></span>
						<span class="bg-neutral h-5 w-5 rounded-full"></span>
					</div>
					<button type="button" class="btn btn-circle btn-lg sm:btn-sm" data-theme-step="1" aria-label="Next theme">
						<i class="fa-solid fa-chevron-right"></i>
					</button>
				</div>
				<div class="mt-3 flex items-center gap-3">
					<span class="text-base-content/60 shrink-0 text-xs font-semibold">{% trans %}Choose directly{% endtrans %}</span>
					<button type="button" class="btn btn-outline btn-sm min-w-0 flex-1 justify-between font-semibold" popovertarget="theme-direct-menu" style="anchor-name:--theme-direct-anchor">
						<span class="truncate" data-theme-direct-name>corporate</span>
						<i class="fa-solid fa-chevron-down text-xs"></i>
					</button>
					<ul id="theme-direct-menu" class="dropdown menu max-h-[min(60vh,26rem)] w-64 gap-0.5 overflow-y-auto rounded-box bg-base-100 p-1 shadow-xl" popover style="position-anchor:--theme-direct-anchor">
						{% for theme in themes %}
							<li data-theme="{{ theme }}">
								<button type="button" class="flex items-center gap-2 py-1 outline-2 -outline-offset-2 outline-transparent" data-act-class="outline-primary!" data-set-theme="{{ theme }}" aria-label="Select theme {{ theme }}">
									<span class="min-w-0 flex-1 truncate text-xs font-semibold">{{ theme }}</span>
									<span class="flex h-1.5 w-10 shrink-0 overflow-hidden rounded-full" aria-label="Theme colors">
										<span class="bg-primary flex-1"></span>
										<span class="bg-secondary flex-1"></span>
										<span class="bg-accent flex-1"></span>
										<span class="bg-neutral flex-1"></span>
									</span>
								</button>
							</li>
						{% endfor %}
					</ul>
				</div>
			</section>
		</div>
	</div>
	<form method="dialog" class="modal-backdrop">
		<button>close</button>
	</form>
</dialog>
