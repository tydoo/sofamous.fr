<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="x-apple-disable-message-reformatting">
        <title>{{ subject|default('Sofamous') }}</title>
        <!--[if mso]>
        <xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml>
        <![endif]-->
        <style>
            body { margin: 0; padding: 0; -webkit-text-size-adjust: 100%; }
            table { border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
            @media screen and (max-width: 600px) {
                .outer { padding: 16px 8px !important; }
                .inner { padding-left: 24px !important; padding-right: 24px !important; }
                .heading { font-size: 24px !important; line-height: 32px !important; }
                .header-column { display: block !important; width: 100% !important; text-align: left !important; }
                .header-tagline { padding-top: 16px !important; }
            }
        </style>
    </head>
    <body style="margin: 0; padding: 0; width: 100%; background-color: #f4f5f7; color: #1d1d1d; font-family: Arial, Helvetica, sans-serif;">
        {% if preheader|default('') %}
            <div style="display: none; max-height: 0; max-width: 0; overflow: hidden; opacity: 0; mso-hide: all;">{{ preheader }}</div>
        {% endif %}

        <table role="presentation" width="100%" style="width: 100%; background-color: #f4f5f7;">
            <tr>
                <td class="outer" align="center" style="padding: 32px 16px;">
                    <!--[if mso]><table role="presentation" width="720" align="center"><tr><td><![endif]-->
                    <table role="presentation" width="100%" style="width: 100%; max-width: 720px; background-color: #ffffff; border: 1px solid #e4e7ec; border-radius: 16px; border-collapse: separate; border-spacing: 0;">
                        <tr>
                            <td class="inner" style="padding: 32px 40px 0;">
                                {% block header %}
                                    <table role="presentation" width="100%" style="width: 100%;">
                                        <tr>
                                            <td class="header-column" valign="middle" width="55%" style="width: 55%;">
                                                <a href="{{ absolute_url(path('home.home')) }}" style="display: inline-block; color: #1d1d1d; text-decoration: none;">
                                                    <img src="{{ absolute_url(asset('images/logo-light.svg')) }}" width="192" height="32" alt="Sofamous" style="display: block; width: 192px; max-width: 100%; height: auto; border: 0; color: #1d1d1d; font-size: 24px; font-weight: bold;">
                                                </a>
                                            </td>
                                            <td class="header-column header-tagline" align="right" valign="middle" width="45%" style="width: 45%;">
                                                <p style="margin: 0; color: #2563eb; font-size: 15px; line-height: 22px; font-weight: bold; letter-spacing: -0.2px;">{{ header_tagline|default('header_tagline'|trans({}, 'global')) }}</p>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="2" style="padding-top: 24px;">
                                                <table role="presentation" width="100%" style="width: 100%;">
                                                    <tr>
                                                        <td width="48" style="width: 48px; border-top: 3px solid #2563eb; font-size: 0; line-height: 0;">&nbsp;</td>
                                                        <td style="border-top: 1px solid #eceef1; font-size: 0; line-height: 0;">&nbsp;</td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                {% endblock %}
                            </td>
                        </tr>
                        <tr>
                            <td class="inner" style="padding: 32px 40px 36px; overflow-wrap: break-word;">
                                {% block content %}
                                        content ...
                                {% endblock %}
                            </td>
                        </tr>
                    </table>
                    <!--[if mso]></td></tr></table><![endif]-->
                    {% block footer %}
                        <table role="presentation" width="100%" style="width: 100%; max-width: 720px;">
                            <tr>
                                <td align="center" style="padding: 16px 16px 0; color: #737780; font-size: 11px; line-height: 20px;">
                                    <span style="display: inline-block; margin: 0 8px;">&copy; {{ 'now'|date('Y') }} Sofamous</span>
                                    <a href="{{ absolute_url(path('about.terms')) }}" style="display: inline-block; margin: 0 8px; color: #737780; text-decoration: none;">À propos</a>
                                    <a href="{{ absolute_url(path('about.privacy')) }}" style="display: inline-block; margin: 0 8px; color: #737780; text-decoration: none;">Confidentialité</a>
                                </td>
                            </tr>
                        </table>
                    {% endblock %}
                    {% block unsubscribe %}
                        <table role="presentation" width="100%" style="width: 100%; max-width: 720px;">
                            <tr>
                                <td align="center" style="padding: 12px 16px 0; color: #737780; font-size: 11px; line-height: 20px;">
                                    <a href="{{ absolute_url(path('email.unsubscribe')) }}" style="display: inline-block; color: #737780; text-decoration: underline;">Se désabonner</a>
                                </td>
                            </tr>
                        </table>
                    {% endblock %}
                </td>
            </tr>
        </table>
    </body>
</html>
