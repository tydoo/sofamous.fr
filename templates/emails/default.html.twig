{% apply spaceless %}
<!DOCTYPE html>
<html lang="fr" xmlns="http://www.w3.org/1999/xhtml">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="x-apple-disable-message-reformatting">
		<title>
			{% block email_title %}
				{{ title|default('Une nouveauté vous attend') }}
			{% endblock %}
		</title>
		<style>
			@media screen and(max-width: 600px) {
				.email-container {
					width: 100% !important;
					max-width: 100% !important;
				}
				.email-padding {
					padding-left: 24px !important;
					padding-right: 24px !important;
				}
				.email-title {
					font-size: 29px !important;
					line-height: 35px !important;
				}
				.email-stack {
					display: block !important;
					width: 100% !important;
					max-width: 100% !important;
				}
				.email-blue {
					padding: 30px 24px !important;
				}
				.email-copy {
					padding: 34px 24px 38px !important;
				}
				.email-meta {
					display: block !important;
					float: none !important;
					margin-top: 12px !important;
				}
				.email-logo {
					width: 124px !important;
				}
			}
		</style>
	</head>
	<body style="margin: 0; padding: 0; width: 100%; background-color: #e7f1fb; color: #10243e; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;">
		<div style="display: none; max-height: 0; overflow: hidden; opacity: 0; color: transparent;">
			{{ preheader|default('Découvrez les dernières nouvelles de Sofamous.') }}
		</div>

		<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width: 100%; background-color: #e7f1fb;">
			<tr>
				<td align="center" style="padding: 28px 16px;">
					<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="800" class="email-container" style="width: 800px; max-width: 800px; background-color: #ffffff;">
						<tr>
							<td class="email-padding" style="padding: 24px 38px; background-color: #ffffff; border-bottom: 1px solid #d8e2ee;">
								<span style="display: inline-block;">
									<img class="email-logo" src="{{ absolute_url(asset('images/svg/logo-light.svg')) }}" width="132" alt="Sofamous" style="display: block; width: 132px; max-width: 100%; height: auto; border: 0;">
								</span>
								<span class="email-meta" style="float: right; color: #55718f; font-size: 11px; font-weight: 700; letter-spacing: 1.2px; line-height: 20px; text-transform: uppercase;">Votre réseau, en un coup d’œil</span>
							</td>
						</tr>
						<tr>
							<td style="padding: 0;">
								{% block email_content %}
									<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width: 100%;">
										<tr>
											<td class="email-stack email-blue" valign="top" width="38%" style="width: 38%; padding: 46px 34px; background-color: #2f80c9;">
												<p style="margin: 0 0 8px; color: #dceeff; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; line-height: 18px; text-transform: uppercase;">Nouveau</p>
												<p style="margin: 0; color: #ffffff; font-size: 78px; font-weight: 700; letter-spacing: -4px; line-height: 78px;">01</p>
											</td>
											<td class="email-stack email-copy" valign="top" width="62%" style="width: 62%; padding: 46px 42px; background-color: #dceeff;">
												<p style="margin: 0 0 12px; color: #24669f; font-size: 12px; font-weight: 700; letter-spacing: 1.4px; line-height: 18px; text-transform: uppercase;">Nouveau dans votre réseau</p>
												<h1 class="email-title" style="margin: 0 0 16px; color: #10243e; font-size: 36px; font-weight: 700; letter-spacing: -0.7px; line-height: 42px;">{{ heading|default('Les choses intéressantes commencent ici.') }}</h1>
												<p style="margin: 0; color: #385671; font-size: 15px; line-height: 24px;">{{ message|default('Retrouvez votre communauté, partagez vos découvertes et ne manquez rien de ce qui compte pour vous.') }}</p>
												{% if cta_url is defined and cta_url %}
													<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top: 28px;">
														<tr>
															<td style="background-color: #10243e;">
																<a href="{{ cta_url }}" style="display: inline-block; padding: 14px 20px; color: #ffffff; font-size: 14px; font-weight: 700; line-height: 20px; text-decoration: none;">{{ cta_label|default('Découvrir') }}
																	&nbsp;→</a>
															</td>
														</tr>
													</table>
												{% endif %}
											</td>
										</tr>
									</table>
								{% endblock %}
							</td>
						</tr>
						<tr>
							<td class="email-padding" align="center" style="padding: 16px 38px; background-color: #10243e;">
								<p style="margin: 0; color: #c8ced2; font-size: 11px; line-height: 18px;">
									Vous recevez cet email car vous utilisez Sofamous. &nbsp;
									{% block email_footer %}
										<a href="{{ unsubscribe_url|default('#') }}" style="color: #ffffff; text-decoration: underline;">Se désabonner</a>
									{% endblock %}
								</p>
							</td>
						</tr>
					</table>
					<p style="margin: 16px 0 0; color: #6683a1; font-size: 11px; line-height: 18px; text-align: center;">©
						{{ 'now'|date('Y') }}
						Sofamous &nbsp;·&nbsp;
						<a href="{{ about_url|default('#') }}" style="color: #496b8c; text-decoration: underline;">About</a>
						&nbsp;·&nbsp;
						<a href="{{ privacy_url|default('#') }}" style="color: #496b8c; text-decoration: underline;">Privacy</a>
					</p>
				</td>
			</tr>
		</table>
	</body>
</html>
{% endapply %}
